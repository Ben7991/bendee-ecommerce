{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles/index.css",
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./atoms": {
      "types": "./dist/components/atoms/index.d.ts",
      "import": "./dist/components/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/components/molecules/index.d.ts",
      "import": "./dist/components/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/components/organisms/index.d.ts",
      "import": "./dist/components/organisms/index.js"
    },
    "./templates": {
      "types": "./dist/components/templates/index.d.ts",
      "import": "./dist/components/templates/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "rollup -c && tsc -p tsconfig.build.json",
    "dev": "rollup -c -w",
    "dev:types": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:component": "turbo gen component",
    "build:clean": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toggle-group": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@turbo/gen": "2.11.11",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "jsdom": "31.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "4.68.5",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-preserve-directives": "0.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
